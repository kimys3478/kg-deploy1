/**
 * KIGLE Excavation — Cloudflare Workers 정적 사이트 배포 설정
 * GitHub main에 푸시하면 Cloudflare Workers Builds가 자동으로:
 *   빌드: node scripts/build-dist.mjs   (사이트 파일만 dist 폴더로 복사)
 *   배포: npx wrangler deploy
 * 이 노트북에서 직접 배포할 때: my-first-worker 폴더에서  npx wrangler deploy --config ../wrangler.jsonc
 */
{
	"name": "kigle-excavation",
	"compatibility_date": "2026-10-06",
	"assets": {
		"directory": "./dist"
	}
}
